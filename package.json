{
    "name":  "demo-frantoio-plugin",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "prepare":  "husky",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "typecheck":  "next typegen \u0026\u0026 tsc --noEmit",
                    "audit":  "npm audit --audit-level=high",
                    "predelivery":  "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm run audit \u0026\u0026 npm run test \u0026\u0026 npm run build \u0026\u0026 npm run test:e2e"
                },
    "lint-staged":  {
                        "*.{js,jsx,ts,tsx}":  [
                                                  "eslint --fix",
                                                  "prettier --write"
                                              ],
                        "*.{json,md,css}":  [
                                                "prettier --write"
                                            ]
                    },
    "dependencies":  {
                         "@base-ui/react":  "^1.7.0",
                         "class-variance-authority":  "^0.7.1",
                         "clsx":  "^2.1.1",
                         "gsap":  "^3.15.0",
                         "lenis":  "^1.3.26",
                         "lucide-react":  "^1.31.0",
                         "next":  "16.3.0",
                         "react":  "19.2.8",
                         "react-dom":  "19.2.8",
                         "shadcn":  "^4.16.2",
                         "tailwind-merge":  "^3.6.0",
                         "tw-animate-css":  "^1.4.0"
                     },
    "devDependencies":  {
                            "@axe-core/playwright":  "^4.12.1",
                            "@playwright/test":  "^1.62.1",
                            "@tailwindcss/postcss":  "^4",
                            "@testing-library/jest-dom":  "^7.0.0",
                            "@testing-library/react":  "^16.3.2",
                            "@types/node":  "^20",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "@vitejs/plugin-react":  "^5.2.0",
                            "eslint":  "^9",
                            "eslint-config-next":  "16.3.0",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-jsx-a11y":  "^6.10.2",
                            "husky":  "^9.1.7",
                            "jsdom":  "^30.0.1",
                            "lint-staged":  "^17.3.0",
                            "prettier":  "^3.9.6",
                            "tailwindcss":  "^4",
                            "typescript":  "^5",
                            "vitest":  "^4.1.10"
                        }
}